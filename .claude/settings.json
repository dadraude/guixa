{
    "permissions": {
        "allow": [
            "Bash(git add:*)",
            "Bash(git commit -m:*)",
            "Bash(git checkout -b feature/*)",
            "Bash(git checkout -b bugfix/*)",
            "Bash(git push -u origin feature/*)",
            "Bash(git push -u origin bugfix/*)",
            "Bash(git push origin feature/*)",
            "Bash(git push origin bugfix/*)",
            "Bash(gh pr create:*)",
            "Bash(gh pr view:*)",
            "Bash(gh pr list:*)"
        ],
        "deny": [
            "Bash(git push --force:*)",
            "Bash(git push -f:*)",
            "Bash(git push origin main:*)",
            "Bash(git push origin HEAD:main:*)",
            "Bash(gh pr merge:*)"
        ]
    }
}
