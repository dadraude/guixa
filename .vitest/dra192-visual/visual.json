    "views": [
        {
            "id": "accounts",
            "path": "/.vitest/dra192-visual/index.html",
            "query": {
                "scenario": "accounts",
                "role": "manager"
            },
            "root": "html[data-visual-ready=\"true\"] .pilot-page",
            "panels": ".pilot-page",
            "fonts": ["16px \"Instrument Sans\""],
            "focus": ["[data-visual-focus-last=\"true\"]"],
            "states": [
                {
                    "id": "populated"
                },
                {
                    "id": "empty",
                    "query": {
                        "empty": 1
                    },
                    "checks": {
                        "focus": [],
                        "noFocusReason": "Empty Accounts has no page control; the shared manager shell is covered by populated manager views."
                    }
                },
                {
                    "id": "long-content",
                    "query": {
                        "long": 1
                    }
                },
                {
                    "id": "validation-processing",
                    "query": {
                        "error": 1,
                        "processing": 1
                    }
                },
                {
                    "id": "system-appearance",
                    "query": {
                        "appearance": "system"
                    }
                },
                {
                    "id": "reduced-motion",
                    "reducedMotion": true
                },
                {
                    "id": "font-fallback",
                    "query": {
                        "fallback": 1
                    },
                    "checks": {
                        "fonts": ["16px sans-serif"],
                        "systemFonts": true
                    }
                }
            ],
            "content": "h1,h2,h3,label,input,select,textarea,button,a,td,th,p,span,[data-visual-text]"
        },
