            "fonts": ["16px Nunito Variable"],
            "focus": [
                "button[data-sidebar=\"trigger\"]",
                "[data-test=\"attention-group\"] a"
            ],
            "states": [
                {
                    "id": "populated",
                    "cases": [
                        {
                            "width": 375,
                            "mode": "light",
                            "text": 100
                        },
                        {
                            "width": 375,
                            "mode": "dark",
                            "text": 100
