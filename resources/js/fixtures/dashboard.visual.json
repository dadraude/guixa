        "widths": [375, 1024, 1280],
        "modes": ["light", "dark"],
        "text": [100, 200]
    },
    "views": [
        {
            "id": "dashboard-member",
            "path": "/resources/visual/dra-205.html",
            "query": {
                "page": "Dashboard",
                "role": "member"
            },
            "root": ".reference-style",
