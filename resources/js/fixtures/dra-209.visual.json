            "fonts": ["16px Nunito Variable"],
            "states": [
                {
                    "id": "populated",
                    "ready": "body[data-visual-ready=\"populated\"]",
                    "cases": [
                        {
                            "width": 375,
                            "mode": "light",
                            "text": 100
                        },
                        {
                            "width": 375,
                            "mode": "dark",
                            "text": 100
                        },
                        {
                            "width": 1280,
                            "mode": "light",
                            "text": 100
