{
    "baseUrl": "http://127.0.0.1:5189",
    "rootFontPx": 16,
    "darkSelector": "html.dark",
    "matrix": {
        "widths": [375, 1024, 1280],
        "modes": ["light", "dark", "system-light", "system-dark"],
        "text": [100, 200]
