                    ],
                    "checks": {
                        "assertions": [
                            {
                                "selector": ".pilot-theme:has(#main-content)",
                                "count": 1
                            },
                            {
                                "selector": "#main-content .pilot-layout-page",
                                "count": 1,
                                "gapRem": 1.5,
                                "styles": {
                                    "display": "flex",
                                    "flex-direction": "column",
                                    "font-family": "\"Nunito Variable\", ui-sans-serif, system-ui, sans-serif"
