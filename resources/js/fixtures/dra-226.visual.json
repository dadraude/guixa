{
    "baseUrl": "http://127.0.0.1:5226",
    "rootFontPx": 16,
    "darkSelector": "html.dark",
    "matrix": {
        "widths": [375, 1024, 1280],
        "modes": ["light", "dark"],
        "text": [100, 200]
    },
    "views": [
        {
            "id": "manager-collection",
            "path": "/visual-dra-226.html",
            "query": { "role": "manager" },
            "root": "#main-content",
            "panels": "#main-content .pilot-layout-panel,#main-content .pilot-list-row",
            "content": "#main-content h1,#main-content h2,#main-content p,#main-content label,#main-content textarea,#main-content button,#main-content a,#main-content dt,#main-content dd,#main-content li",
            "fonts": ["16px Nunito Variable"],
            "focus": [
                "#main-content a[data-visual-page-focus-first]",
                "#main-content a[data-test=\"wallet-link\"]",
                "#main-content [data-test=\"collect-basket\"]"
            ],
            "states": [
                {
                    "id": "corrected",
                    "query": { "state": "corrected" },
                    "ready": "body[data-visual-ready=\"corrected\"]",
                    "cases": [
                        { "width": 375, "mode": "light", "text": 100 },
                        { "width": 375, "mode": "dark", "text": 100 },
                        { "width": 1280, "mode": "light", "text": 100 },
                        { "width": 1280, "mode": "dark", "text": 100 },
                        { "width": 1024, "mode": "light", "text": 200 },
                        { "width": 1024, "mode": "dark", "text": 200 }
                    ],
                    "checks": {
                        "assertions": [
                            {
                                "selector": "[data-test=\"basket-status-validated\"]",
                                "count": 1
                            },
                            {
                                "selector": "[data-test=\"collection-history\"] li",
                                "count": 2
                            },
                            {
                                "selector": "[data-test=\"collection-correction-form\"]",
                                "count": 0
                            },
                            {
                                "selector": "[data-test=\"effective-collection\"]",
                                "text": "Pendent de recollida"
                            },
                            {
                                "selector": "[data-test=\"collect-basket\"]",
                                "minHeight": 44
                            }
                        ]
                    }
                },
                {
                    "id": "never",
                    "query": { "state": "never" },
                    "ready": "body[data-visual-ready=\"never\"]",
                    "cases": [
                        { "width": 375, "mode": "light", "text": 100 },
                        { "width": 1024, "mode": "dark", "text": 200 }
                    ],
                    "checks": {
