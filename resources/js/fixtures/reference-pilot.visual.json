{
    "baseUrl": "http://127.0.0.1:5185",
    "rootFontPx": 16,
    "darkSelector": "html.dark",
    "matrix": {
        "widths": [375, 1024, 1280],
        "modes": ["light", "dark"],
        "text": [100, 200]
    },
    "views": [
        {
            "id": "manager-cycles",
            "path": "/visual-reference-pilot.html",
            "query": { "screen": "cycles" },
            "root": ".reference-pilot",
            "panels": ".pilot-manager-page, [data-sidebar='sidebar']",
            "content": "h1,h2,label,input,a,summary,button:not([data-sidebar='trigger']):not([id^='reka-dropdown-menu-trigger']),[data-visual-text]",
            "fonts": ["16px Nunito Variable"],
            "focus": [
                "button[data-sidebar='trigger']",
                "[data-test='open-create-cycle']",
                "[data-test='summary-cycle-1']",
                "[data-test='manage-cycle-1']"
            ],
            "states": [
                {
                    "id": "populated",
                    "cases": [
                        { "width": 375, "mode": "light", "text": 100 },
                        { "width": 375, "mode": "dark", "text": 100 },
                        { "width": 1280, "mode": "light", "text": 100 },
                        { "width": 1280, "mode": "dark", "text": 100 },
                        { "width": 1024, "mode": "light", "text": 200 },
                        { "width": 1024, "mode": "dark", "text": 200 }
                    ]
                },
                {
                    "id": "empty",
                    "query": { "state": "empty" },
                    "checks": {
                        "focus": [
                            "button[data-sidebar='trigger']",
                            "[data-test='open-create-cycle']"
                        ]
                    },
                    "cases": [{ "width": 375, "mode": "dark", "text": 100 }]
                },
                {
                    "id": "long-content",
                    "query": { "state": "long" },
                    "cases": [{ "width": 1024, "mode": "light", "text": 200 }]
                },
                {
                    "id": "create-dialog",
                    "query": { "state": "dialog" },
                    "ready": "dialog[open]",
                    "settled": ["dialog[open]"],
                    "checks": {
                        "root": "body",
                        "panels": ".manager-dialog",
                        "content": "dialog[open] h2,dialog[open] label,dialog[open] input,dialog[open] button,[data-visual-text]",
                        "focus": ["dialog[open] button[type='submit']"]
                    },
                    "cases": [{ "width": 375, "mode": "dark", "text": 200 }]
                },
                {
                    "id": "mobile-drawer",
                    "query": { "state": "drawer" },
                    "ready": "[data-sidebar='sidebar'][data-mobile='true']",
                    "settled": ["[data-sidebar='sidebar'][data-mobile='true']"],
                    "checks": {
                        "root": "body",
                        "panels": "[data-sidebar='sidebar'][data-mobile='true'] .reference-sidebar-brand,[data-sidebar='sidebar'][data-mobile='true'] nav",
                        "content": "[data-sidebar='sidebar'][data-mobile='true'] a,[data-sidebar='sidebar'][data-mobile='true'] button,[data-visual-text]",
                        "focus": [
                            ".reference-sidebar-brand",
                            "[data-section='Cooperative'] [data-test='section-trigger']"
                        ]
                    },
                    "cases": [
                        { "width": 375, "mode": "light", "text": 200 },
                        { "width": 375, "mode": "dark", "text": 200 }
                    ]
                }
            ]
        },
        {
            "id": "manager-producers",
            "path": "/visual-reference-pilot.html",
            "query": { "screen": "producers" },
            "root": ".reference-pilot",
            "panels": ".pilot-manager-page, [data-sidebar='sidebar']",
            "content": "h1,h2,label,input,a,button:not([data-sidebar='trigger']):not([id^='reka-dropdown-menu-trigger']),[data-visual-text]",
            "fonts": ["16px Nunito Variable"],
            "focus": [
                "button[data-sidebar='trigger']",
                "#producer-name",
                "#producer-days",
                "[data-test='create-producer']",
                "#account-name-producer-1",
                "#account-email-producer-1",
                "[data-test='invite-producer-1']"
            ],
            "states": [
                {
                    "id": "populated",
                    "cases": [
                        { "width": 375, "mode": "light", "text": 100 },
                        { "width": 375, "mode": "dark", "text": 100 },
                        { "width": 1280, "mode": "light", "text": 100 },
                        { "width": 1280, "mode": "dark", "text": 100 },
                        { "width": 1024, "mode": "light", "text": 200 },
                        { "width": 1024, "mode": "dark", "text": 200 }
                    ]
                },
                {
                    "id": "empty",
                    "query": { "state": "empty" },
                    "checks": {
                        "focus": [
                            "button[data-sidebar='trigger']",
                            "#producer-name",
                            "#producer-days",
                            "[data-test='create-producer']"
                        ]
                    },
                    "cases": [{ "width": 375, "mode": "light", "text": 100 }]
                },
                {
                    "id": "long-content",
                    "query": { "state": "long" },
                    "cases": [{ "width": 375, "mode": "dark", "text": 200 }]
                }
            ]
        }
    ]
}
