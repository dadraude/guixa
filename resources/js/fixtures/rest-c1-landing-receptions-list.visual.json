                "page": "Receptions/Index",
                "role": "manager,receiver"
            },
            "root": ".reference-style",
            "panels": "#main-content",
            "content": "#main-content h1:not(.sr-only),#main-content h2,#main-content p,#main-content a,#main-content li span",
            "fonts": ["16px Nunito Variable"],
            "focus": ["#main-content ul a[aria-label]"],
            "states": [
                {
                    "id": "mixed-light",
                    "query": {
                        "state": "default"
                    },
                    "ready": "body[data-visual-ready]",
                    "settled": [".reference-style"],
                    "checks": {
                        "assertions": [
                            {
                                "selector": ".reference-style.landing",
                                "count": 1
                            },
                            {
                                "selector": ".pilot-theme:not(.landing)",
                                "count": 0
                            },
                            {
                                "selector": ".welcome-page",
                                "count": 0
                            },
                            {
                                "selector": "#main-content *",
                                "styles": {
                                    "background-image": "none"
                                }
                            },
                            {
                                "selector": "#main-content h1:not(.sr-only)",
                                "count": 1,
                                "contrast": 4.5
                            },
                            {
                                "selector": "#main-content h2,#main-content .font-medium,#main-content .material-status > span:not(.material-status-dot)",
                                "contrast": 4.5
                            },
                            {
                                "selector": "#main-content ul a[aria-label]",
                                "minHeight": 44,
                                "minWidth": 44,
                                "contrast": 4.5
                            },
                            {
                                "selector": "#main-content [data-test^=\"cycle-\"] > div",
                                "rowGapRem": 0.75
                            },
                            {
                                "selector": "#main-content [data-test^=\"producer-\"]",
                                "gapRem": 0.75
                            },
                            {
                                "selector": "#main-content [data-test^=\"producer-\"] > div",
                                "gapRem": 0.75
                            },
                            {
                                "selector": "body",
                                "attributes": {
                                    "data-ev-error": null
                                }
                            }
                        ]
                    },
