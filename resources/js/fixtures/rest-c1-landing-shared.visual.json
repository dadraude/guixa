                {
                    "id": "select-touch",
                    "query": {
                        "state": "select-touch"
                    },
                    "ready": "body[data-visual-ready]",
                    "settled": [".reference-style"],
                    "checks": {
                        "focus": [],
                        "noFocusReason": "Interaction driven by dispatched events.",
                        "assertions": [
                            {
                                "selector": ".landing",
                                "count": 0
                            },
                            {
                                "selector": "body",
                                "attributes": {
                                    "data-ev-error": null,
                                    "data-ev-opened-by": "touch",
                                    "data-ev-arrowed": "Família Vidal",
                                    "data-ev-chosen": "Família Vidal",
                                    "data-ev-chosen-matches": "true",
                                    "data-ev-changed": "true",
                                    "data-ev-focus-returned-after-choice": "true",
                                    "data-ev-focus-returned-after-escape": "true",
                                    "data-ev-escape-closed": "true"
                                }
                            }
                        ]
                    },
                    "cases": [
                        {
                            "width": 375,
                            "mode": "light",
                            "text": 100
                        }
                    ]
                }
            ]
        },
        {
            "id": "reception-shell",
            "path": "/resources/js/fixtures/rest-c1-landing.html",
            "query": {
                "page": "Receptions/Show",
                "role": "manager,receiver"
            },
            "root": ".reference-style",
            "panels": "#main-content",
            "content": "#main-content h1:not(.sr-only)",
            "fonts": ["16px Nunito Variable"],
            "focus": [],
            "noFocusReason": "Shell overlays capture focus; focus order is covered by the reception-show view.",
            "states": [
                {
                    "id": "nav-sheet",
                    "query": {
                        "state": "nav-sheet"
                    },
                    "ready": "body[data-visual-ready]",
                    "settled": [".reference-style"],
                    "checks": {
                        "focus": [],
                        "noFocusReason": "The open sheet captures focus.",
                        "assertions": [
                            {
                                "selector": ".reference-style.landing",
                                "count": 1
                            },
                            {
                                "selector": "body",
                                "attributes": {
                                    "data-ev-error": null,
                                    "data-ev-sheet-landing": "true"
                                }
                            }
                        ]
                    },
                    "cases": [
                        {
                            "width": 375,
                            "mode": "light",
                            "text": 100
                        },
                        {
                            "width": 375,
                            "mode": "dark",
                            "text": 100
                        }
                    ]
                }
            ]
        }
    ]
}
