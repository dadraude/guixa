{
    "baseUrl": "http://127.0.0.1:5187",
    "rootFontPx": 16,
    "darkSelector": "html.dark",
    "views": [
        {
            "id": "welcome",
            "path": "/resources/visual/welcome.html",
            "root": "[data-visual-root]",
            "panels": "[data-visual-panel]",
            "content": "h1,h2,p,a,li",
            "fonts": ["16px Nunito Variable"],
            "focus": [
                ".welcome-brand",
                ".welcome-nav a",
                "#welcome-action",
                ".welcome-primary-action",
                ".welcome-text-action",
                ".welcome-contact-button",
                ".welcome-email"
            ],
            "assertions": [
                {
                    "selector": ".welcome-header .welcome-brand",
                    "minHeight": 44
                },
                {
                    "selector": ".welcome-access",
                    "minHeight": 44,
                    "contrast": 4.5
                },
                {
                    "selector": ".welcome-primary-action",
                    "minHeight": 44,
                    "contrast": 4.5
                },
                {
                    "selector": ".welcome-contact-button",
                    "minHeight": 44,
                    "contrast": 4.5
                },
                { "selector": ".welcome-step-number", "contrast": 4.5 },
                {
                    "selector": ".welcome-email",
                    "attributes": { "href": "mailto:laguixamanresa@gmail.com" }
                }
            ],
            "states": [
                {
                    "id": "guest",
                    "cases": [
                        {
                            "width": 375,
                            "mode": "light",
                            "text": 100
                        },
                        {
                            "width": 375,
                            "mode": "dark",
                            "text": 100
                        },
                        {
                            "width": 1280,
                            "mode": "light",
                            "text": 100
                        },
                        {
                            "width": 1280,
                            "mode": "dark",
                            "text": 100
                        },
                        {
                            "width": 1024,
                            "mode": "light",
                            "text": 200
                        },
                        {
                            "width": 1024,
                            "mode": "dark",
                            "text": 200
                        },
                        {
                            "width": 375,
                            "mode": "light",
                            "text": 200
                        },
                        {
                            "width": 375,
                            "mode": "dark",
                            "text": 200
                        },
                        {
                            "width": 1280,
                            "mode": "light",
                            "text": 200
                        },
                        {
                            "width": 1280,
                            "mode": "dark",
                            "text": 200
                        }
                    ]
                },
                {
                    "id": "authenticated",
                    "query": {
                        "authenticated": 1
                    },
                    "cases": [
                        {
                            "width": 375,
                            "mode": "light",
                            "text": 100
                        },
                        {
                            "width": 375,
                            "mode": "dark",
                            "text": 100
                        },
                        {
                            "width": 1280,
                            "mode": "light",
                            "text": 100
                        },
                        {
                            "width": 1280,
                            "mode": "dark",
                            "text": 100
                        }
                    ]
                }
            ]
        }
    ],
    "matrix": {
        "widths": [375, 1024, 1280],
        "modes": ["light", "dark"],
        "text": [100, 200]
    }
}
