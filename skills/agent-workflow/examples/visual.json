{
    "baseUrl": "http://127.0.0.1:5180",
    "rootFontPx": 16,
    "darkSelector": "html.dark",
    "matrix": {
        "widths": [375, 1024, 1280],
        "modes": ["light", "dark"],
        "text": [100, 200]
    },
    "views": [
        {
            "id": "member-statement",
            "path": "/visual-fixture.html",
            "query": { "scenario": "statement", "role": "member" },
            "root": "main",
            "panels": ".panel",
            "fonts": ["16px \"Instrument Sans\""],
            "focus": ["a[data-back]", "button[data-submit]"],
            "states": [
                {
                    "id": "populated",
                    "cases": [
                        { "width": 375, "mode": "light", "text": 100 },
                        { "width": 375, "mode": "dark", "text": 100 },
                        { "width": 1280, "mode": "light", "text": 100 },
                        { "width": 1280, "mode": "dark", "text": 100 },
                        { "width": 1024, "mode": "light", "text": 200 }
                    ]
                },
                {
                    "id": "long-name",
                    "query": { "long": 1 },
                    "cases": [{ "width": 375, "mode": "light", "text": 200 }]
                },
                {
                    "id": "processing",
                    "query": { "processing": 1 },
                    "cases": [{ "width": 375, "mode": "light", "text": 100 }],
                    "checks": { "focus": ["a[data-back]"] }
                }
            ]
        }
    ]
}
